<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>..\..\rhythkitlogo.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="AgentUiBootstrap.cs" />
    <Compile Include="AgentSettings.cs" />
    <Compile Include="TokenStore.cs" />
    <Compile Include="GameConnectionState.cs" />
    <Compile Include="GameBridgeInbox.cs" />
    <Compile Include="GameBridgeDispatcher.cs" />
    <Compile Include="RankedMapStore.cs" />
    <Compile Include="RhythKitSettingsForm.cs" />
    <Compile Include="SspScoreWatcher.cs" />
    <Compile Include="VulnusConverterLauncher.cs" />
    <Compile Include="VulnusConverterForm.cs" />
    <Compile Include="AgentPorts.cs" />
    <Content Include="..\..\rhythkitlogo.ico" Link="rhythkitlogo.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
