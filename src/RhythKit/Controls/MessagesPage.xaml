<UserControl x:Class="RhythKit.Controls.MessagesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RhythKit.Models">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= LEFT COLUMN ======================= -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Messages" Style="{StaticResource H1Text}" FontSize="22"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                 Fill="{Binding ConnectionColor}"/>
                        <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource MutedText}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Content="New Group"
                            Command="{Binding CreateGroupCommand}" Padding="12,7" Margin="0,0,6,0"/>
                </StackPanel>
            </Grid>

            <!-- Search -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource AppTextBox}"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Search Rhythia users..."
                         KeyDown="SearchBox_KeyDown"/>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Search"
                        Command="{Binding SearchCommand}" Margin="8,0,0,0" Padding="14,8"/>
            </Grid>

            <!-- Search results -->
            <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="8" Margin="0,0,0,10"
                    MaxHeight="210" Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="12" FontWeight="Bold" Foreground="#0D0F14"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Username}" Style="{StaticResource BodyText}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButton}" Content="Message"
                                                Command="{Binding DataContext.MessageUserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Padding="10,6" Margin="0,0,6,0" FontSize="12"/>
                                        <Button Content="Add Friend"
                                                Command="{Binding DataContext.AddFriendCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Padding="10,6" FontSize="12">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FriendState}" Value="Outgoing">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                            <Setter Property="Content" Value="Sent"/>
                                                            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FriendState}" Value="Mutual">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FriendState}" Value="Incoming">
                                                            <Setter Property="Content" Value="Accept"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Friend requests -->
            <Border Grid.Row="3" Style="{StaticResource CardPanel}" Padding="12" Margin="0,0,0,10"
                    Visibility="{Binding HasFriendRequests, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="FRIEND REQUESTS" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding FriendRequests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AccentBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="11" FontWeight="Bold" Foreground="#0D0F14"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Username}" Style="{StaticResource BodyText}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButton}" Content="Accept"
                                                Command="{Binding DataContext.AcceptRequestCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Padding="10,5" Margin="0,0,6,0" FontSize="11"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="Decline"
                                                Command="{Binding DataContext.DeclineRequestCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Padding="10,5" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Conversations -->
            <TextBlock Grid.Row="4" Text="CONVERSATIONS" Style="{StaticResource MutedText}" FontSize="11" Margin="2,0,0,6"/>
            <ListBox Grid.Row="5" ItemsSource="{Binding Conversations}"
                     SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" CornerRadius="10" Background="Transparent" Padding="10,9">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource CardBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Border>
                                <Ellipse Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Margin="0,0,1,1"
                                         Fill="{StaticResource SuccessBrush}" Visibility="{Binding IsOtherOnline, Converter={StaticResource BoolToVis}}"/>
                            </Grid>

                            <StackPanel Grid.Column="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                        <Border Background="{StaticResource AccentDarkBrush}" CornerRadius="6"
                                                Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsMutual, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="★ Friend" FontSize="9" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource AccentBrush}" CornerRadius="9"
                                            MinWidth="18" Height="18" Padding="4,0"
                                            VerticalAlignment="Center" Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding UnreadLabel}" FontSize="10" FontWeight="Bold"
                                                   Foreground="#0D0F14" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="12"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ======================= RIGHT COLUMN ======================= -->
        <Border Grid.Column="1" Style="{StaticResource CardPanel}">
            <Grid>
                <!-- Empty state -->
                <StackPanel x:Name="EmptyPane" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource PanelBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Select a conversation to start chatting" Style="{StaticResource H2Text}"/>
                    <TextBlock Text="Search for users on the left and send them a message, or create a group."
                               Style="{StaticResource MutedText}" Margin="0,6,0,0" TextAlignment="Center"/>
                </StackPanel>

                <!-- Active chat -->
                <Grid x:Name="ChatPane" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{StaticResource BgAltBrush}" CornerRadius="12,12,0,0"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding SelectedConversation.Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedConversation.DisplayName}" Style="{StaticResource H2Text}" FontSize="15"/>
                                <TextBlock Text="{Binding ChatStatus}" Style="{StaticResource MutedText}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Content="Add Member"
                                        Command="{Binding AddMemberCommand}" Padding="10,6" FontSize="12"
                                        Margin="0,0,6,0"
                                        Visibility="{Binding SelectedConversation.IsGroup, Converter={StaticResource BoolToVis}}"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="Leave"
                                        Command="{Binding LeaveGroupCommand}" Padding="10,6" FontSize="12"
                                        Visibility="{Binding SelectedConversation.IsGroup, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Messages -->
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="16,14">
                            <ItemsControl ItemsSource="{Binding Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border x:Name="bubble" Grid.Row="0" MaxWidth="430"
                                                    Background="{StaticResource CardBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="14" Padding="12,9"
                                                    HorizontalAlignment="Left">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding AuthorUsername}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,3"
                                                               Visibility="{Binding ShowAuthorInGroup, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource BodyText}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextWrapping="Wrap" Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}"/>
                                                    <Border x:Name="attChip" Background="{StaticResource BgAltBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="8" Padding="10,8" Margin="0,2,0,0"
                                                            Visibility="{Binding HasAttachment, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Attachment.FileName}" FontWeight="SemiBold"
                                                                       FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                <Border Background="{StaticResource AccentDarkBrush}" CornerRadius="5"
                                                                        Padding="6,2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Attachment.Extension}" FontSize="9"
                                                                               Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Attachment.DisplaySize}" Style="{StaticResource MutedText}"
                                                                           FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                                <Button Style="{StaticResource SecondaryButton}" Content="Download"
                                                                        Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" Padding="8,4" FontSize="11"
                                                                        Margin="12,0,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding TimeDisplay}" Style="{StaticResource MutedText}"
                                                               FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Button Grid.Row="0" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                    Width="26" Height="26" Padding="0" Margin="6,0,0,0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Background="Transparent" Foreground="{StaticResource TextMutedBrush}"
                                                    Cursor="Hand"
                                                    Visibility="{Binding IsMine, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Delete message"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="del" CornerRadius="6" Background="{TemplateBinding Background}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="del" Property="Background" Value="{StaticResource DangerColor}"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                <Setter TargetName="bubble" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="bubble" Property="Margin" Value="0,0,32,0"/>
                                                <Setter TargetName="bubble" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                                <Setter TargetName="bubble" Property="BorderBrush" Value="{StaticResource AccentDarkBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMine}" Value="False">
                                                <Setter TargetName="bubble" Property="HorizontalAlignment" Value="Left"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Input -->
                    <Border Grid.Row="2" Background="{StaticResource BgAltBrush}" CornerRadius="0,0,12,12"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="Attach File"
                                    Command="{Binding AttachCommand}" Padding="12,8" Margin="0,0,10,0"/>

                            <TextBox Grid.Column="1" Style="{StaticResource AppTextBox}"
                                     Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="MessageBox_KeyDown"
                                     MinHeight="38" VerticalContentAlignment="Center"
                                     Tag="Type a message..."/>

                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Send"
                                    Command="{Binding SendCommand}" Padding="16,8" Margin="10,0,0,0"
                                    HorizontalContentAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
