<UserControl x:Class="RhythKit.Controls.ColorsetMakerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RhythKit.Controls"
             xmlns:models="clr-namespace:RhythKit.Models">
    <UserControl.Resources>
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="main" CornerRadius="8" Background="{Binding ColorBrush}"
                                    BorderBrush="#00000000" BorderThickness="0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.4" Color="Black"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="sel" CornerRadius="8" BorderBrush="#799DFA" BorderThickness="2.5"
                                    Visibility="Collapsed" Margin="-1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="sel" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="main" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,24,0">
                <TextBlock Text="Colorset Maker" Style="{StaticResource H1Text}"/>
                <TextBlock Text="Create custom note colorsets for Rhythia" Style="{StaticResource MutedText}" Margin="0,4,0,20"/>

                <Border Style="{StaticResource CardPanel}" Padding="20,16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Number of Colors" Style="{StaticResource H2Text}"/>
                            <TextBlock Text="How many color swatches to create" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource AppTextBox}" Width="90" TextAlignment="Center"
                                 FontSize="16" FontWeight="Bold"
                                 Text="{Binding ColorCount, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardPanel}" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Color Swatches" Style="{StaticResource H2Text}"/>
                        <TextBlock Text="Click a swatch to select it, then pick a color on the wheel" Style="{StaticResource MutedText}" Margin="0,3,0,14"/>
                        <ItemsControl ItemsSource="{Binding Colors}" Name="SwatchGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SwatchButton}"
                                            Tag="{Binding IsSelected}"
                                            Click="Swatch_Click">
                                        <Button.ToolTip>
                                            <TextBlock Text="{Binding Hex}"/>
                                        </Button.ToolTip>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hue Wheel" Style="{StaticResource H2Text}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="{Binding WheelColorBrush}" Stroke="#00000000" StrokeThickness="1" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding WheelHex}" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Click or drag on the wheel to set the selected swatch color" Style="{StaticResource MutedText}" Margin="0,3,0,14"/>
                        <controls:HueWheel SelectedColor="{Binding WheelColor, Mode=TwoWay}"
                                           Width="220" Height="220"
                                           HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Save Colorset" Style="{StaticResource H2Text}"/>
                        <TextBlock Text="Save the colorset as a .txt file with one hex color per row" Style="{StaticResource MutedText}" Margin="0,3,0,16"/>

                        <TextBlock Text="Colorset Name" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource AppTextBox}" Text="{Binding ColorsetName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="Save Path" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource AppTextBox}"
                                     Text="{Binding SavePath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Browse"
                                    Command="{Binding BrowseCommand}" Margin="8,0,0,0" Padding="12,8"/>
                        </Grid>

                        <Button Style="{StaticResource PrimaryButton}" Content="Download Colorset"
                                Command="{Binding DownloadCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"
                                HorizontalContentAlignment="Center">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" FontSize="14"/>
                                        <TextBlock Text="Download Colorset" FontSize="14"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>

                        <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" Margin="0,12,0,0"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Style="{StaticResource CardPanel}" Padding="16" Margin="0,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Recent Colorsets" Style="{StaticResource H2Text}" Margin="0,0,0,4"/>
                <TextBlock DockPanel.Dock="Top" Text="Click a saved colorset to load its colors" Style="{StaticResource MutedText}" Margin="0,0,0,14"/>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButton}" Content="Load Selected"
                        Command="{Binding LoadHistoryCommand}" Margin="0,12,0,0"/>

                <ListBox ItemsSource="{Binding HistoryFiles}"
                         SelectedItem="{Binding SelectedHistoryPath, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="Padding" Value="8,8"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" CornerRadius="6" Background="Transparent" Padding="10,8">
                                            <TextBlock Text="{Binding}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CardBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
