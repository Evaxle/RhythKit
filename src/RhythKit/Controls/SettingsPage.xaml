<UserControl x:Class="RhythKit.Controls.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,24,0" MaxWidth="640" HorizontalAlignment="Left">
            <Image Source="/Assets/logo.png" Width="110" Height="34" Stretch="Uniform"
                   HorizontalAlignment="Left" Margin="0,0,0,6"/>
            <TextBlock Text="Settings" Style="{StaticResource H1Text}"/>
            <TextBlock Text="Configure RhythKit preferences" Style="{StaticResource MutedText}" Margin="0,4,0,20"/>

            <Border Style="{StaticResource CardPanel}" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Colorsets Folder" Style="{StaticResource H2Text}"/>
                    <TextBlock Text="Default location where colorsets are saved" Style="{StaticResource MutedText}" Margin="0,3,0,16"/>

                    <TextBlock Text="Default Save Path" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource AppTextBox}"
                                 Text="{Binding ColorsetsPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Browse"
                                Command="{Binding BrowseCommand}" Margin="8,0,0,0" Padding="12,8"/>
                    </Grid>

                    <Button Style="{StaticResource PrimaryButton}" Content="Save Settings"
                            Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,20,0,0"
                            HorizontalContentAlignment="Center"/>

                    <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" Margin="0,12,0,0"
                               Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Profile &amp; Online" Style="{StaticResource H2Text}"/>
                    <TextBlock Text="Your Rhythia identity and the RhythKit server you connect to for messages." Style="{StaticResource MutedText}" Margin="0,3,0,16"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource AccentBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Initials}" FontSize="16" FontWeight="Bold" Foreground="#0D0F14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Username}" Style="{StaticResource BodyText}"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ProfileId}" Style="{StaticResource MutedText}" FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <Button Style="{StaticResource SecondaryButton}" Content="Change Profile"
                            Command="{Binding ChangeProfileCommand}" HorizontalAlignment="Left" Padding="14,8"/>

                    <TextBlock Text="RhythKit Server URL" Style="{StaticResource LabelText}" Margin="0,18,0,6"/>
                    <TextBox Style="{StaticResource AppTextBox}"
                             Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="The online chat server. Everyone who wants to chat with you must use the same server URL."
                               Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource H2Text}"/>
                    <TextBlock Text="RhythKit Toolkit v1.0 - The best external kit for Rhythia" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                    <TextBlock Text="Colorset files are saved as .txt with one hex color per row." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
