<Window x:Class="RhythKit.Windows.ProfileSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RhythKit - Set Up Profile"
        Height="560" Width="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="SetupTextBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>
    <Border CornerRadius="14" Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="2" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BgAltBrush}" CornerRadius="14,14,0,0"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid x:Name="TitleBar" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock Text="Welcome to RhythKit" Style="{StaticResource H1Text}" FontSize="17"
                               Margin="20,16" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource WindowControlBtn}" Content="&#xE8BB;"
                            Click="CloseBtn_Click" Margin="0,6,8,0"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,24">
                    <Image Source="/Assets/logo.png" Width="150" Height="46" Stretch="Uniform"
                           HorizontalAlignment="Left" Margin="0,0,0,14"/>

                    <TextBlock Text="Connect your Rhythia profile" Style="{StaticResource H2Text}"/>
                    <TextBlock Text="Paste the link to your Rhythia profile so other users can find you by name."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,18"/>

                    <TextBlock Text="Rhythia Profile URL" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ProfileUrlBox" Grid.Column="0" Style="{StaticResource SetupTextBox}"
                                 Text="https://www.rhythia.com/player/"/>
                        <Button Grid.Column="1" Content="Fetch" Style="{StaticResource SecondaryButton}"
                                Click="FetchBtn_Click" Margin="8,0,0,0" Padding="14,8" x:Name="FetchBtn"/>
                    </Grid>

                    <Border Style="{StaticResource CardPanel}" Padding="14" Margin="0,14,0,0" x:Name="ProfilePreview"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource AccentBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="AvatarInitials" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="18" FontWeight="Bold" Foreground="#0D0F14"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="FoundName" Style="{StaticResource H2Text}" FontSize="15"/>
                                <TextBlock x:Name="FoundId" Style="{StaticResource MutedText}" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="RhythKit Server URL" Style="{StaticResource LabelText}" Margin="0,18,0,6"/>
                    <TextBox x:Name="ServerUrlBox" Style="{StaticResource SetupTextBox}"
                             Text="http://localhost:5210"/>

                    <TextBlock Text="The online chat server your friends also connect to. Defaults to the local RhythKit server."
                               Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <Button x:Name="SaveBtn" Style="{StaticResource PrimaryButton}" Content="Save &amp; Continue"
                            HorizontalAlignment="Left" Margin="0,22,0,0" Padding="22,11"
                            IsEnabled="False" Click="SaveBtn_Click"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource BodyText}" Margin="0,12,0,0"
                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
