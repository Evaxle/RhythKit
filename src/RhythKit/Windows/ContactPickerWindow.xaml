<Window x:Class="RhythKit.Windows.ContactPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Contacts"
        Height="520" Width="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Border CornerRadius="14" Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="2" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BgAltBrush}" CornerRadius="14,14,0,0"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid x:Name="TitleBar" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Margin="20,14">
                        <TextBlock x:Name="TitleText" Style="{StaticResource H2Text}" FontSize="16"/>
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource WindowControlBtn}" Content="&#xE8BB;"
                            Click="CancelBtn_Click" Margin="0,6,8,0"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,16,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="GroupNameBox" Style="{StaticResource AppTextBox}"
                         Text="Group Chat" Margin="0,0,0,14" Visibility="Collapsed"/>

                <Border Grid.Row="1" Style="{StaticResource CardPanel}">
                    <ListBox x:Name="ContactsList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionMode="Single">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource CardBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="13" FontWeight="Bold" Foreground="#0D0F14"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Username}" Style="{StaticResource BodyText}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="20,16,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="EmptyText" Text="No contacts yet. Add some friends first!"
                           Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="ConfirmBtn" Style="{StaticResource PrimaryButton}"
                        Content="Add" IsEnabled="False" Click="ConfirmBtn_Click" Margin="8,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
