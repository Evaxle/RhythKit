<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
<TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RhythKit</RootNamespace>
    <AssemblyName>RhythKit</AssemblyName>
    <ApplicationIcon>Assets\RhythKit.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Authors>RhythKit</Authors>
    <Product>RhythKit</Product>
    <Description>RhythKit - The best external toolkit for Rhythia</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>

</Project>
